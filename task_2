import turtle


def koch_curve(t, length, level):
    """
    Малює одну сторону кривої Коха.
    """

    if level == 0:
        t.forward(length)
    else:
        length = length / 3

        koch_curve(t, length, level - 1)
        t.left(60)

        koch_curve(t, length, level - 1)
        t.right(120)

        koch_curve(t, length, level - 1)
        t.left(60)

        koch_curve(t, length, level - 1)


def koch_snowflake(t, length, level):
    """
    Малює сніжинку Коха з трьох кривих Коха.
    """

    for _ in range(3):
        koch_curve(t, length, level)
        t.right(120)


def main():
    level = int(input("Введіть рівень рекурсії: "))

    screen = turtle.Screen()
    screen.title("Сніжинка Коха")

    t = turtle.Turtle()
    t.speed(0)

    t.penup()
    t.goto(-200, 120)
    t.pendown()

    koch_snowflake(t, 400, level)

    turtle.done()


if __name__ == "__main__":
    main()
